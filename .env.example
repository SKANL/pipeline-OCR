# Copy to .env and fill in. Empty values fall back to the defaults in app/config.py.
# Never commit .env (it holds real secrets).

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=biblioteca

# --- Object storage (S3-compatible: SeaweedFS locally, Cloudflare R2 in production) ---
# Empty S3_ENDPOINT_URL => local disk under MEDIA_ROOT (served at /media).
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
S3_BUCKET=biblioteca
S3_REGION=auto
# Empty => page images are served with signed GET URLs.
S3_PUBLIC_BASE_URL=
# Local Docker only: host the browser uses to reach S3 (e.g. http://localhost:9000). Leave empty on R2.
S3_PRESIGN_ENDPOINT_URL=
MEDIA_ROOT=./_media

# --- Uploads and limits ---
MAX_UPLOAD_BYTES=104857600
MAX_FILE_BYTES=52428800
PAGE_IMAGE_DPI=150
RATE_LIMIT_SEARCH_PER_MIN=120
RATE_LIMIT_WRITE_PER_MIN=20
# true behind a trusted proxy (Render); keys rate limits by the proxy-appended client IP.
TRUST_PROXY_HEADERS=false

# --- Auth ---
# HS256 secret shared with the PWA (its API_AUTH_SECRET). Empty => no editor tokens.
AUTH_SECRET=
# Bootstrap admins, comma separated.
ADMIN_EMAILS=
# Ops key for scripts (X-API-Key). Empty with AUTH_SECRET empty => writes are open (dev only).
API_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:3010
# Absolute dirs allowed for POST /ingest (admin/ops only), comma separated. Empty => disabled.
INGEST_ALLOWED_ROOTS=

# --- Worker and pipeline ---
WORKER_ENABLED=true
TEXT_CLEANUP=true
SCAN_PREPROCESS=true
# Java layout helper; set false on Render free (PDFium text only).
OPENDATALOADER_ENABLED=true

# --- OCR (switch provider at any time: tesseract | mistral | glm) ---
OCR_PROVIDER=tesseract
OCR_LANGS=spa+lat
OCR_DPI=300
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
GLM_API_KEY=
GLM_OCR_MODEL=glm-ocr
GLM_API_BASE_URL=https://api.z.ai/api/paas/v4

# --- docker compose only (full local stack; dev-only defaults live in docker-compose.yml) ---
# LOCAL_AUTH_SECRET=
# LOCAL_ADMIN_EMAIL=admin@biblioteca.local
# LOCAL_OPENDATALOADER_ENABLED=true
